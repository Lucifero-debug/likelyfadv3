# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# and must never hold a real value.

# WHERE THE REEL LIBRARY IS SERVED FROM — the origin, no trailing slash.
# Read by lib/cdn.ts, which derives every clip and poster URL from it as
# <base>/reels/<id>.mp4, <base>/reels/<id>.hq.mp4, <base>/reels/<id>.webp.
#
# For a Vercel Blob store this is https://<store-id>.public.blob.vercel-storage.com
# — `npm run upload:blob` prints the exact value at the end of a run.
#
# LEAVE IT UNSET IN DEVELOPMENT. lib/cdn.ts then falls back to /videos, which is
# the local cache `npm run sync:videos` writes, and the whole wall runs offline.
# In a production build an unset value is a hard build failure, on purpose: it
# would otherwise inline the string "undefined" into all 204 URLs and ship a
# page where nothing loads and nothing errors.
#
# IT IS INLINED AT BUILD TIME. Changing it in the Vercel dashboard does nothing
# until the next deploy — a restart is not enough.
NEXT_PUBLIC_CDN_BASE=

# WRITE ACCESS TO THE BLOB STORE, used only by scripts/upload-blob.mjs on your
# machine. Vercel dashboard -> Storage -> your Blob store -> ".env.local" tab.
#
# NOT NEXT_PUBLIC_, EVER. Anything with that prefix is compiled into the client
# bundle, and this token can overwrite or delete every object in the library.
# It is never needed at runtime by the site — the library is public to read.
BLOB_READ_WRITE_TOKEN=